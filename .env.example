# ---------------------------------------------------------------------------
# Kal-UKFinder — server configuration
# Copy this file to `server/.env` and fill in what you have.
# Every key is OPTIONAL except the admin bootstrap: without the rest the app
# still runs, using public RSS feeds and a deterministic (non-LLM) summariser.
# ---------------------------------------------------------------------------

PORT=4000
# Comma separated list of origins allowed to call the API ("*" for any).
# In production set this to your web app and admin panel origins.
CORS_ORIGIN=*

# --- Database --------------------------------------------------------------
# Leave DATABASE_URL empty to use the local SQLite file — no database server
# needed, which is how `npm run dev` and the test suite work.
#
# Set it to run on Postgres (Supabase). Use the TRANSACTION POOLER string,
# port 6543, host ...pooler.supabase.com — NOT the direct connection on 5432.
# URL-encode the password if it contains @ : / ? # or & (@ becomes %40).
# Verify it with `npm run db:check` in the server folder.
#
# This is a server-side secret. Never give it an EXPO_PUBLIC_ or VITE_ prefix:
# those are compiled into the bundles the browser downloads.
DATABASE_URL=
# Supabase terminates TLS with its own chain; verification is off by default.
DATABASE_SSL=true
# Connections per instance. Keep small — serverless runs many instances.
DATABASE_MAX_CONNECTIONS=3

# --- Scheduled jobs (serverless only) --------------------------------------
# Shared secret for /api/cron/*. Vercel sends it automatically as
# `Authorization: Bearer $CRON_SECRET`. If this is empty those endpoints
# refuse every request rather than running unprotected.
CRON_SECRET=

# --- Administrator bootstrap ----------------------------------------------
# The first ADMIN is created on boot when no administrator exists yet.
# Without these the admin panel has nobody who can sign in.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Where the admin panel is served from — used in password reset links.
ADMIN_URL=http://localhost:5173

# --- Sessions --------------------------------------------------------------
# How long a signed-in session lasts before it must be refreshed.
SESSION_DAYS=30
# How long a password reset link stays valid.
RESET_TOKEN_MINUTES=60
# Set to "false" to close public sign-ups.
ALLOW_REGISTRATION=true
# Set to "false" to disable rate limiting (tests do this automatically).
RATE_LIMIT_ENABLED=true

# --- AI -------------------------------------------------------------------
# Google Gemini. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model used for summarising/classifying collected items (cheap + fast).
GEMINI_FAST_MODEL=gemini-2.5-flash
# Model used for the career coach, CV review and interview prep.
GEMINI_SMART_MODEL=gemini-2.5-pro

# --- Job boards -----------------------------------------------------------
# Adzuna (free tier). https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Reed.co.uk API key. https://www.reed.co.uk/developers
REED_API_KEY=

# --- Collection ------------------------------------------------------------
# The scheduler wakes every minute and collects only the sources whose own
# interval has elapsed, so this switch just turns the whole thing on or off.
INGEST_ENABLED=true
# How many sources are fetched at the same time.
INGEST_CONCURRENCY=4
# Days of content to keep before pruning.
RETENTION_DAYS=45

# --- Crawler manners (pr.md §40) -------------------------------------------
# Identifies us to the sites we fetch. Keep a contact URL in it.
SCRAPER_USER_AGENT=Kal-UKFinder/1.0 (+https://github.com/kal-ukfinder; UK jobs and policy aggregator)
# Minimum gap between two requests to the same host, unless robots.txt asks for more.
SCRAPE_POLITENESS_MS=1500
# Leave this on. Turning it off means ignoring sites that asked not to be crawled.
RESPECT_ROBOTS=true

# --- Notifications --------------------------------------------------------
# The digest job wakes hourly and delivers to each user at the hour they chose
# in the app (profile.notifications.digestHour, UK time).
DIGEST_CRON=0 * * * *
DIGEST_ENABLED=true
# Optional Expo access token for higher push rate limits.
EXPO_ACCESS_TOKEN=

# --- Storage ---------------------------------------------------------------
# SQLite file. Mount a volume at this path in production.
# DB_PATH=./data/kal-ukfinder.db
