{
  "name": "@kal-ukfinder/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aggregation + AI API for Kal-UKFinder",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "ingest": "node --env-file-if-exists=.env src/scripts/ingest-once.js",
    "digest": "node --env-file-if-exists=.env src/scripts/send-digest.js",
    "test": "node --test --env-file-if-exists=.env \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "fast-xml-parser": "^5.2.5",
    "helmet": "^8.3.0",
    "node-cron": "^4.2.1",
    "zod": "^4.1.13"
  }
}
